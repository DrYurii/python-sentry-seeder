# Copy to .env and fill in your values. .env is gitignored.
#
# Required for seeding (get from Sentry: Project Settings → Client Keys (DSN)):
# SENTRY_DSN="https://YOUR_KEY@oXXXX.ingest.sentry.io/PROJECT_ID"
SENTRY_DSN=""

# Optional: for create_sentry_release.py and for fetching DSN via API (project:read / project:releases):
# SENTRY_AUTH_TOKEN="sntrys_..."
# SENTRY_ORG="your-org-slug"
# SENTRY_PROJECT="your-project-slug"

# Optional overrides for seed scripts (defaults are in README):
# SENTRY_RELEASE="seed-script@1.0.0"
# SENTRY_SEED_ENVIRONMENTS="production,staging,development"
# SEED_COUNT=100
# SEED_EVENTS_PER_ISSUE=5
# SEED_PERSISTENT_EVENTS_PER_RUN=5
